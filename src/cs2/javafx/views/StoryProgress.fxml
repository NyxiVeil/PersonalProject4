<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs2.javafx.controllers.StoryProgressController"
      style="-fx-background-color: #E8C97A; -fx-padding: 40;">

    <Label fx:id="dayTitleLabel" text="Day X"
           style="-fx-text-fill: #3B1F00;
                  -fx-font-family: 'Georgia';
                  -fx-font-size: 28px;
                  -fx-font-weight: bold;
                  -fx-effect: dropshadow(gaussian, rgba(107,76,17,0.3), 4, 0.5, 1, 1);" />

    <Label fx:id="storyDescriptionLabel" text="Description"
           wrapText="true"
           style="-fx-text-fill: #2B1200;
                  -fx-font-family: 'Georgia';
                  -fx-font-size: 16px;
                  -fx-font-style: italic;" />

    <HBox fx:id="choicesContainer" alignment="CENTER" spacing="15">
        <!-- Buttons injected here by controller -->
    </HBox>

    <VBox fx:id="developerToolsContainer" alignment="CENTER" spacing="10"
          style="-fx-padding: 20 0 0 0; -fx-border-color: #8B1A1A; -fx-border-width: 2 0 0 0; -fx-margin: 20 0 0 0;">
        <Label text="Developer Options (Test Skip)" style="-fx-text-fill: #8B1A1A; -fx-font-weight: bold;" />
        <HBox alignment="CENTER" spacing="15">
            <Button text="Auto Win" onAction="#handleAutoWin"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Auto Lose" onAction="#handleAutoLose"
                    style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

</VBox>
