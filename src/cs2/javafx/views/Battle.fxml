<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Battle.fxml — RPG-style combat pane.
    Aesthetic: warm parchment / medieval fantasy (matches the reference art).

    Two panels controlled by BattleController:
      1. setupPanel  — class/enemy selector shown before battle starts
      2. battlePanel — arena background, HP plates, action buttons
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cs2.javafx.controllers.BattleController"
            style="-fx-background-color: #E8C97A;">

    <center>
        <VBox spacing="0"
              style="-fx-background-color: #E8C97A;">

            <!-- ═══════════════════════════════════════════════════════
                 SETUP PANEL  (visible before battle starts)
                 TEMPORARY TEST FEATURE — REMOVE LATER
                 ═══════════════════════════════════════════════════ -->
            <VBox fx:id="setupPanel" spacing="18" alignment="CENTER"
                  style="-fx-background-color: #D4A843;
                         -fx-padding: 32;
                         -fx-border-color: #6B4C11;
                         -fx-border-width: 3;
                         -fx-border-radius: 4;">

                <Label text="⚔  Battle Setup"
                       style="-fx-text-fill: #3B1F00;
                              -fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-font-family: 'Georgia';" />

                <!-- Class selector -->
                <VBox spacing="6" alignment="CENTER">
                    <Label text="Choose Your Class:"
                           style="-fx-text-fill: #4B2800;
                                  -fx-font-size: 14px;
                                  -fx-font-family: 'Georgia';" />
                    <ComboBox fx:id="classSelector" promptText="Select Class..."
                              prefWidth="240" onAction="#onClassSelected"
                              style="-fx-font-size: 13px;" />
                    <Label fx:id="passiveLabel" text=""
                           style="-fx-text-fill: #5C3A00;
                                  -fx-font-size: 12px;
                                  -fx-font-style: italic;
                                  -fx-max-width: 340px;
                                  -fx-wrap-text: true;
                                  -fx-alignment: center;"
                           wrapText="true" />
                </VBox>

                <Separator style="-fx-background-color: #8B6010;" />

                <!-- Enemy selector -->
                <VBox spacing="6" alignment="CENTER">
                    <Label text="Choose Enemy:"
                           style="-fx-text-fill: #4B2800;
                                  -fx-font-size: 14px;
                                  -fx-font-family: 'Georgia';" />
                    <ComboBox fx:id="enemySelector" promptText="Select Enemy..."
                              prefWidth="260"
                              style="-fx-font-size: 13px;" />
                </VBox>

                <Separator style="-fx-background-color: #8B6010;" />

                <!-- Start button -->
                <Button fx:id="startBattleBtn" text="▶  Start Battle"
                        prefWidth="200" prefHeight="44"
                        onAction="#onStartBattle"
                        style="-fx-background-color: #8B1A1A;
                               -fx-text-fill: #FFE0A0;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-font-family: 'Georgia';
                               -fx-border-color: #3B0000;
                               -fx-border-width: 2;
                               -fx-border-radius: 3;
                               -fx-background-radius: 3;
                               -fx-cursor: hand;" />

                <Label text="Pre-loaded items: 2× Apple · 1× Health Potion"
                       style="-fx-text-fill: #7A5020; -fx-font-size: 11px;" />

            </VBox>

            <!-- ═══════════════════════════════════════════════════════
                 BATTLE PANEL  (visible during active combat)
                 ═══════════════════════════════════════════════════ -->
            <VBox fx:id="battlePanel" spacing="0" alignment="CENTER"
                  style="-fx-background-color: #E8C97A;"
                  visible="false" managed="false">

                <!-- ── ARENA FRAME ────────────────────────────────── -->
                <!--
                    StackPane lets us overlay the turn label and HP plates
                    directly on top of the "scene painting" gradient background.
                -->
                <StackPane prefHeight="240" maxWidth="1.7976931348623157E308"
                           style="-fx-background-color:
                                      linear-gradient(to bottom,
                                          #87CEEB 0%, #B0DCF0 30%,
                                          #C8E6C9 55%, #81A86A 80%,
                                          #4E7A35 100%);
                                  -fx-border-color: #6B4C11;
                                  -fx-border-width: 4;
                                  -fx-effect: dropshadow(gaussian, #3B1F0088, 8, 0.3, 0, 3);">

                    <!-- AnchorPane to position turn label top-center
                         and HP plates constrained to a maximum width so they stay together -->
                    <AnchorPane maxWidth="650"
                                maxHeight="1.7976931348623157E308">

                        <!-- Turn indicator — top-center badge -->
                        <Label fx:id="turnLabel" text="Your Turn"
                               AnchorPane.topAnchor="10"
                               AnchorPane.leftAnchor="0"
                               AnchorPane.rightAnchor="0"
                               style="-fx-background-color: rgba(240,220,160,0.85);
                                      -fx-text-fill: #3B1F00;
                                      -fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-font-family: 'Georgia';
                                      -fx-padding: 4 20 4 20;
                                      -fx-border-color: #6B4C11;
                                      -fx-border-width: 1.5;
                                      -fx-alignment: center;
                                      -fx-max-width: 220px;" />

                        <!-- Player name plate + HP bar — bottom-left -->
                        <VBox spacing="2"
                              AnchorPane.bottomAnchor="12"
                              AnchorPane.leftAnchor="12"
                              style="-fx-background-color: rgba(220,200,140,0.92);
                                     -fx-border-color: #6B4C11;
                                     -fx-border-width: 2;
                                     -fx-padding: 4 10 4 10;
                                     -fx-min-width: 160px;">
                            <Label fx:id="playerNameLabel" text="Player"
                                   style="-fx-text-fill: #1A1A1A;
                                          -fx-font-size: 14px;
                                          -fx-font-weight: bold;
                                          -fx-font-family: 'Georgia';
                                          -fx-alignment: center;
                                          -fx-max-width: 160;" />
                            <!-- Red HP bar with text on top -->
                            <StackPane>
                                <ProgressBar fx:id="playerHPBar" progress="1.0"
                                             prefWidth="160" prefHeight="22"
                                             style="-fx-accent: #CC0000;
                                                    -fx-control-inner-background: #550000;" />
                                <Label fx:id="playerHPLabel" text="HP: 125 / 125"
                                       style="-fx-text-fill: white;
                                              -fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-effect: dropshadow(gaussian, black, 2, 1, 0, 0);" />
                            </StackPane>
                        </VBox>

                        <!-- Enemy name plate + HP bar — bottom-right -->
                        <VBox spacing="2"
                              AnchorPane.bottomAnchor="12"
                              AnchorPane.rightAnchor="12"
                              style="-fx-background-color: rgba(220,200,140,0.92);
                                     -fx-border-color: #6B4C11;
                                     -fx-border-width: 2;
                                     -fx-padding: 4 10 4 10;
                                     -fx-min-width: 160px;">
                            <Label fx:id="enemyNameLabel" text="Enemy"
                                   style="-fx-text-fill: #1A1A1A;
                                          -fx-font-size: 14px;
                                          -fx-font-weight: bold;
                                          -fx-font-family: 'Georgia';
                                          -fx-alignment: center;
                                          -fx-max-width: 160;" />
                            <StackPane>
                                <ProgressBar fx:id="enemyHPBar" progress="1.0"
                                             prefWidth="160" prefHeight="22"
                                             style="-fx-accent: #CC0000;
                                                    -fx-control-inner-background: #550000;" />
                                <Label fx:id="enemyHPLabel" text="HP: 10 / 10"
                                       style="-fx-text-fill: white;
                                              -fx-font-size: 11px;
                                              -fx-font-weight: bold;
                                              -fx-effect: dropshadow(gaussian, black, 2, 1, 0, 0);" />
                            </StackPane>
                        </VBox>

                    </AnchorPane>
                </StackPane>

                <!-- ── ACTION BUTTONS (3-col grid, parchment style) ── -->
                <VBox spacing="8" alignment="CENTER"
                      style="-fx-background-color: #E8C97A; -fx-padding: 16 20 8 20;">

                    <GridPane hgap="12" vgap="10" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="150" />
                            <ColumnConstraints prefWidth="150" />
                            <ColumnConstraints prefWidth="150" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints prefHeight="42" />
                            <RowConstraints prefHeight="42" />
                        </rowConstraints>

                        <!-- Row 0 -->
                        <Button fx:id="btnAttack"  text="Attack"
                                maxWidth="Infinity" maxHeight="Infinity"
                                onAction="#onAttack"
                                GridPane.columnIndex="0" GridPane.rowIndex="0"
                                style="-fx-background-color: #D4A843;
                                       -fx-text-fill: #2B1200;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-font-family: 'Georgia';
                                       -fx-border-color: #6B4C11;
                                       -fx-border-width: 2;
                                       -fx-border-radius: 3;
                                       -fx-background-radius: 3;
                                       -fx-cursor: hand;" />

                        <Button fx:id="btnDodge"   text="Dodge"
                                maxWidth="Infinity" maxHeight="Infinity"
                                onAction="#onDodge"
                                GridPane.columnIndex="1" GridPane.rowIndex="0"
                                style="-fx-background-color: #D4A843;
                                       -fx-text-fill: #2B1200;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-font-family: 'Georgia';
                                       -fx-border-color: #6B4C11;
                                       -fx-border-width: 2;
                                       -fx-border-radius: 3;
                                       -fx-background-radius: 3;
                                       -fx-cursor: hand;" />

                        <Button fx:id="btnUseItem" text="Use Item"
                                maxWidth="Infinity" maxHeight="Infinity"
                                onAction="#onUseItem"
                                GridPane.columnIndex="2" GridPane.rowIndex="0"
                                style="-fx-background-color: #D4A843;
                                       -fx-text-fill: #2B1200;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-font-family: 'Georgia';
                                       -fx-border-color: #6B4C11;
                                       -fx-border-width: 2;
                                       -fx-border-radius: 3;
                                       -fx-background-radius: 3;
                                       -fx-cursor: hand;" />

                        <!-- Row 1 -->
                        <Button fx:id="btnBlock"   text="Block"
                                maxWidth="Infinity" maxHeight="Infinity"
                                onAction="#onBlock"
                                GridPane.columnIndex="0" GridPane.rowIndex="1"
                                style="-fx-background-color: #D4A843;
                                       -fx-text-fill: #2B1200;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-font-family: 'Georgia';
                                       -fx-border-color: #6B4C11;
                                       -fx-border-width: 2;
                                       -fx-border-radius: 3;
                                       -fx-background-radius: 3;
                                       -fx-cursor: hand;" />

                        <Button fx:id="btnFlee"    text="Flee"
                                maxWidth="Infinity" maxHeight="Infinity"
                                onAction="#onFlee"
                                GridPane.columnIndex="1" GridPane.rowIndex="1"
                                style="-fx-background-color: #D4A843;
                                       -fx-text-fill: #2B1200;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-font-family: 'Georgia';
                                       -fx-border-color: #6B4C11;
                                       -fx-border-width: 2;
                                       -fx-border-radius: 3;
                                       -fx-background-radius: 3;
                                       -fx-cursor: hand;" />

                        <!-- col 2 row 1: intentionally empty (matches reference layout) -->

                    </GridPane>

                    <!-- Action tooltip strip -->
                    <Label fx:id="actionTooltipLabel" text=" "
                           style="-fx-text-fill: #3B1F00;
                                  -fx-font-size: 13px;
                                  -fx-font-style: italic;
                                  -fx-min-height: 20px;" />

                    <!-- Inventory strip -->
                    <Label fx:id="inventoryLabel" text="Inventory: (empty)"
                           style="-fx-text-fill: #5C3A00;
                                  -fx-font-size: 11px;
                                  -fx-font-style: italic;" />

                    <!-- Restart button (shown after battle ends) -->
                    <Button fx:id="btnRestart" text="↩  New Battle"
                            prefWidth="180" prefHeight="36"
                            visible="false" managed="false"
                            onAction="#onRestart"
                            style="-fx-background-color: #8B1A1A;
                                   -fx-text-fill: #FFE0A0;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-font-family: 'Georgia';
                                   -fx-border-color: #3B0000;
                                   -fx-border-width: 2;
                                   -fx-border-radius: 3;
                                   -fx-background-radius: 3;
                                   -fx-cursor: hand;" />

                </VBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>
