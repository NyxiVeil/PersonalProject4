<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    StartScreen.fxml — Main menu before starting the game.
    Styled with the warm parchment / medieval fantasy aesthetic.
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="cs2.javafx.controllers.StartScreenController"
           style="-fx-background-color: #E8C97A;
                  -fx-border-color: #6B4C11;
                  -fx-border-width: 12;
                  -fx-border-style: solid;">

    <!-- Optional inner border for a framed look -->
    <StackPane style="-fx-border-color: #3B1F00; -fx-border-width: 2; -fx-margin: 8;">

        <VBox alignment="CENTER" spacing="50.0">

            <!-- Title -->
            <Label text="Thornhollow RPG"
                   style="-fx-text-fill: #3B1F00;
                          -fx-font-family: 'Georgia';
                          -fx-font-size: 54px;
                          -fx-font-weight: bold;
                          -fx-effect: dropshadow(gaussian, rgba(107,76,17,0.4), 8, 0.5, 2, 4);" />

            <!-- Subtitle / Flourish -->
            <Label text="✦ An Epic Adventure Awaits ✦"
                   style="-fx-text-fill: #6B4C11;
                          -fx-font-family: 'Georgia';
                          -fx-font-size: 18px;
                          -fx-font-style: italic;
                          -fx-translate-y: -30;" />

            <!-- Start Button -->
            <Button text="Start Game"
                    onAction="#handleStartGame"
                    prefWidth="220" prefHeight="55"
                    style="-fx-background-color: #8B1A1A;
                           -fx-text-fill: #FFE0A0;
                           -fx-font-size: 20px;
                           -fx-font-weight: bold;
                           -fx-font-family: 'Georgia';
                           -fx-border-color: #3B0000;
                           -fx-border-width: 3;
                           -fx-border-radius: 4;
                           -fx-background-radius: 4;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(59,31,0,0.5), 10, 0.3, 0, 4);" />

        </VBox>

    </StackPane>
</StackPane>
