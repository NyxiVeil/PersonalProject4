<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs2.javafx.controllers.QuestController"
      spacing="15"
      style="-fx-background-color: #E8C97A; -fx-padding: 20; -fx-border-color: #6B4C11; -fx-border-width: 3;"
      prefWidth="500"
      prefHeight="400">

    <Label text="📜 Repeatable Quests"
           style="-fx-text-fill: #3B1F00; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />

    <Label text="Embark on short training quests to gain gold and rare items passively."
           style="-fx-text-fill: #5C3A00; -fx-font-size: 13px; -fx-font-style: italic; -fx-font-family: 'Georgia';"
           wrapText="true" />

    <!-- Quests list -->
    <ListView fx:id="questListView"
              VBox.vgrow="ALWAYS"
              style="-fx-background-color: #F4E4C1; -fx-control-inner-background: #F4E4C1; -fx-border-color: #6B4C11; -fx-border-width: 1.5; -fx-font-family: 'Georgia'; -fx-font-size: 13px;" />

    <!-- Current active quest progress container -->
    <VBox fx:id="progressContainer" spacing="6" visible="false" managed="false"
          style="-fx-background-color: rgba(220,200,140,0.5); -fx-padding: 10; -fx-border-color: #8B6010; -fx-border-width: 1; -fx-border-radius: 4;">
        <Label fx:id="activeQuestNameLabel" text="Quest Running: None"
               style="-fx-text-fill: #3B1F00; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
        <ProgressBar fx:id="questProgressBar" progress="0.0" prefWidth="440" prefHeight="18"
                     style="-fx-accent: #8B1A1A; -fx-control-inner-background: #D4A843;" />
    </VBox>

    <!-- Controls -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="startQuestBtn" text="▶ Start Quest" onAction="#handleStartQuest"
                style="-fx-background-color: #8B1A1A; -fx-text-fill: #FFE0A0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Georgia'; -fx-border-color: #3B0000; -fx-border-width: 1.5; -fx-cursor: hand;" />
    </HBox>

</VBox>
